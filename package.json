{
  "name": "gas-course-web-template",
  "version": "1.0.0",
  "description": "Google Apps Script 網頁應用程式範本（含 GIS 登入、108 課綱課程代碼匯入與 1NF 正規化、多風格現代前端）",
  "scripts": {
    "build:webapp": "node scripts/build-webapp.js",
    "push": "npm run build:webapp && clasp push",
    "pull": "clasp pull",
    "deploy": "node scripts/deploy.js",
    "open": "clasp open",
    "logs": "clasp logs",
    "watch": "clasp push --watch",
    "test": "node scripts/run-tests.js",
    "test:legacy": "node tests/courseCodeNormalization.test.js && node tests/api.test.js",
    "test:coverage": "node scripts/checkCoverage.js --collect-only",
    "check:lang": "node scripts/languageCheck.js",
    "check:ui-classes": "node scripts/checkUiClasses.js",
    "check:coverage": "node scripts/checkCoverage.js",
    "check:changed-coverage": "node scripts/checkChangedCoverage.js",
    "check:complexity": "node scripts/checkComplexity.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node -e \"if(process.env.CI)process.exit(0);try{require('child_process').execSync('npx --no-install husky',{stdio:'inherit'})}catch(e){}\"",
    "open-webapp": "clasp open --webapp",
    "status": "clasp version && clasp deployments"
  },
  "keywords": [
    "google-apps-script",
    "gas",
    "gis",
    "google-identity-services",
    "curriculum-codes",
    "normalization",
    "webapp-template"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@google/clasp": "^3.4.1",
    "c8": "^10.1.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.3.3",
    "typhonjs-escomplex": "^0.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  }
}
